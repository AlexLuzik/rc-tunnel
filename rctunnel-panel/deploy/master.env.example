# Copy to /etc/rcpanel/master.env and edit. Loaded by the systemd unit.
RCTUNNEL_PUBLIC_DOMAIN=rc-tunnel.com
RCTUNNEL_PUBLIC_BASE_URL=https://rc-tunnel.com
# generate: openssl rand -hex 32
RCTUNNEL_JWT_SECRET=CHANGE_ME_LONG_RANDOM
RCTUNNEL_DATABASE_URL=sqlite:////var/lib/rcpanel/rcpanel.db
RCTUNNEL_PKI_DIR=/var/lib/rcpanel/pki
RCTUNNEL_DOWNLOAD_DIR=/var/www/rcpanel-dl
RCTUNNEL_API_HOST=127.0.0.1
RCTUNNEL_API_PORT=8000
# control plane is mTLS and must be reachable by agents directly (open 8001 in the firewall)
RCTUNNEL_CONTROL_HOST=0.0.0.0
RCTUNNEL_CONTROL_PORT=8001
RCTUNNEL_COOKIE_SECURE=true
RCTUNNEL_ALLOW_REGISTER=false
