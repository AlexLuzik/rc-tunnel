# Copy to /etc/rcpanel/master.env and edit. Loaded by the systemd unit.
RCPANEL_PUBLIC_DOMAIN=rc-tunnel.com
RCPANEL_PUBLIC_BASE_URL=https://rc-tunnel.com
# generate: openssl rand -hex 32
RCPANEL_JWT_SECRET=CHANGE_ME_LONG_RANDOM
RCPANEL_DATABASE_URL=sqlite:////var/lib/rcpanel/rcpanel.db
RCPANEL_PKI_DIR=/var/lib/rcpanel/pki
RCPANEL_DOWNLOAD_DIR=/var/www/rcpanel-dl
RCPANEL_API_HOST=127.0.0.1
RCPANEL_API_PORT=8000
# control plane is mTLS and must be reachable by agents directly (open 8001 in the firewall)
RCPANEL_CONTROL_HOST=0.0.0.0
RCPANEL_CONTROL_PORT=8001
RCPANEL_COOKIE_SECURE=true
RCPANEL_ALLOW_REGISTER=false
